# Copy to route_optimizer/.env (adk web / adk deploy read it from the agent folder).

# --- Gemini on Vertex AI (Gemini Enterprise project) ---
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
# Region for AlloyDB, Pub/Sub, Agent Engine and Cloud Run (Gemini itself uses the global endpoint)
REGION=us-central1
# Optional per-role models (default gemini-3.5-flash for both)
# COORDINATOR_MODEL=gemini-3.1-pro-preview
# SPECIALIST_MODEL=gemini-3.5-flash

# --- Data backend: sqlite (offline demo) | bigquery | alloydb ---
DB_BACKEND=sqlite
# SQLITE_PATH=data/mclane_routing.db

# BigQuery
BQ_PROJECT=your-project-id
BQ_DATASET=mclane_routing
BQ_LOCATION=US

# AlloyDB: set ALLOYDB_INSTANCE_URI to use the AlloyDB Python Connector,
# or PG_HOST/PG_PORT for the AlloyDB Auth Proxy / any PostgreSQL.
# ALLOYDB_INSTANCE_URI=projects/your-project-id/locations/us-central1/clusters/mclane/instances/mclane-primary
ALLOYDB_IP_TYPE=PUBLIC
PG_HOST=
PG_PORT=5432
PG_DATABASE=mclane
PG_USER=postgres
PG_PASSWORD=change-me
PG_SCHEMA=mclane_routing

# --- Routing and guardrails ---
SOLVER_TIME_LIMIT_S=15
MAX_ROUTE_HOURS=13
REPLAN_TIME_LIMIT_S=8
DELAY_TRIGGER_MIN=15
ESCALATION_COST_USD=750
REEFER_MAX_TEMP_F=10

# Travel matrix for the solver: haversine (offline) | pcmiler (Trimble PC*MILER) | google_routes (Maps Routes API)
TRAVEL_PROVIDER=haversine
# GOOGLE_MAPS_API_KEY=

# --- Trimble PC*MILER (mileage of record in TMW) ---
# Without a key every route still gets PC*MILER miles from an offline emulation, labelled PCMILER_EMULATED.
# PCMILER_API_KEY=
PCMILER_ROUTING_TYPE=PRACTICAL
# PCMILER_BASE_URL=https://pcmiler.alk.com/apis/rest/v1.0/Service.svc
# PCMILER_REGION=NA
# PCMILER_DATA_VERSION=Current

# --- MCP Toolbox for Databases (optional read-only SQL tools from tools.yaml) ---
# TOOLBOX_URL=http://127.0.0.1:5000
# TOOLBOX_TOOLSET=mclane-analytics

# --- Pub/Sub event bus ---
PUBSUB_TOPIC=mclane-route-events
PUBSUB_SUBSCRIPTION=mclane-route-events-agent

# --- Trimble TMW integration (empty = queue only) ---
TMW_API_BASE_URL=
TMW_API_TOKEN=
